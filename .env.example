# Ingestion
BARGO_API_KEY=
BARGO_BASE_URL=https://www.bargo.ai/free-apis/congress/v1
BARGO_PAGE_LIMIT=100

# Storage: duckdb first, bigquery later
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./congress.duckdb
DBT_DUCKDB_PATH=../congress.duckdb

# BigQuery optional cloud path
GCP_PROJECT_ID=
BIGQUERY_DATASET=senate_trades
GOOGLE_APPLICATION_CREDENTIALS=

# dbt
DBT_PROFILES_DIR=./dbt_project

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=senate-trade-anomaly-detection
MLFLOW_REGISTRY_URI=
MLFLOW_MODEL_NAME=congress-trade-anomaly-detector
MLFLOW_MODEL_ALIAS=production

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
